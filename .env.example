# ==============================================================
# Variables de entorno para Docker Compose
# Copia este archivo como .env y ajusta los valores
# ==============================================================

# Puerto en el que se expone el CMS (default: 8080 desarrollo, 80 producción)
CMS_PORT=8080

# Zona horaria (usada para fechas de artículos y cron)
TZ=America/Guatemala

# Límites de PHP (opcional, para producción)
# PHP_MEMORY_LIMIT=256M
# PHP_MAX_EXECUTION=60
# PHP_UPLOAD_MAX=20M
# PHP_POST_MAX=20M
